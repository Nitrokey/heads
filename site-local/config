
BRAND_NAME=Nitrokey

CONFIG_TPM_NO_LUKS_DISK_UNLOCK=y


ifeq "EOL_x230-hotp-maximized" "$(BOARD)"

	CONFIG_BOARD_NAME="Nitropad x230 | v2.6.2"

else ifeq "EOL_t430-hotp-maximized" "$(BOARD)"

	CONFIG_BOARD_NAME="Nitropad t430 | v2.6.2"

else ifeq "EOL_t480-hotp-maximized" "$(BOARD)"

	CONFIG_BOARD_NAME="Nitropad t480 | v2.6.2"

else ifeq "EOL_t480s-hotp-maximized" "$(BOARD)"

	CONFIG_BOARD_NAME="Nitropad t480s | v2.6.2"

else

CONFIG_BOARD_NAME+=" | v2.6.2"

endif

